{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.types.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    // No ambient type packages: `json.ts` is a standalone type declaration
    // module and must not pull in DOM/Node types transitively.
    "types": [],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // `json.ts` is generated by Specta (`cargo run -p pyxis-driver -- gen-types`)
  // and must not be hand-edited. It is typechecked here on purpose: a stale
  // or hand-mangled generated type is a compile error, not a silent runtime
  // mismatch. Its *formatting* is exempt from `prettier --check` — generator
  // output is self-consistent, and the contributing guidelines permit
  // lint/format skip for generated output.
  "include": ["json.ts"]
}